{
	"name": "copy_azureMySQL_to_iceberg",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureMySqlSource",
						"query": "select * from customermasterdata;",
						"queryTimeout": "02:00:00"
					},
					"sink": {
						"type": "IcebergSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "IcebergWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "Customer_ID",
									"type": "String",
									"physicalType": "varchar"
								},
								"sink": {
									"name": "Customer_ID",
									"physicalType": "string"
								}
							},
							{
								"source": {
									"name": "Name",
									"type": "String",
									"physicalType": "varchar"
								},
								"sink": {
									"name": "Name",
									"physicalType": "string"
								}
							},
							{
								"source": {
									"name": "DOB",
									"type": "DateTime",
									"physicalType": "date"
								},
								"sink": {
									"name": "DOB",
									"physicalType": "date"
								}
							},
							{
								"source": {
									"name": "Email",
									"type": "String",
									"physicalType": "varchar"
								},
								"sink": {
									"name": "Email",
									"physicalType": "string"
								}
							},
							{
								"source": {
									"name": "Phone",
									"type": "String",
									"physicalType": "varchar"
								},
								"sink": {
									"name": "Phone",
									"physicalType": "string"
								}
							},
							{
								"source": {
									"name": "Address",
									"type": "String",
									"physicalType": "varchar"
								},
								"sink": {
									"name": "Address",
									"physicalType": "string"
								}
							},
							{
								"source": {
									"name": "created_at",
									"type": "DateTime",
									"physicalType": "timestamp"
								},
								"sink": {
									"name": "created_at",
									"physicalType": "timestamp"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "AzureMySqlTable1",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "Iceberg1",
						"type": "DatasetReference"
					}
				]
			}
		],
		"folder": {
			"name": "insurance_etl"
		},
		"annotations": []
	}
}