											"name": "Payment_ID",
											"type": "String",
											"physicalType": "nvarchar"
										}
									},
									{
										"source": {
											"name": "Claim_ID",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "Claim_ID",
											"type": "String",
											"physicalType": "nvarchar"
										}
									},
