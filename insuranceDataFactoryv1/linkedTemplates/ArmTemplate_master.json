{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "insuranceDataFactoryv1"
		},
		"AzureMySql1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureMySql1'"
		},
		"AzureSqlDatabase1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabase1'"
		},
		"ls_AzureBlobStorage_insuranceetl_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_AzureBlobStorage_insuranceetl'"
		},
		"ls_AzureDataLakeStorage1_servicePrincipalCredential": {
			"type": "secureString",
			"metadata": "Secure string for 'servicePrincipalCredential' of 'ls_AzureDataLakeStorage1'"
		},
		"ls_CosmosDb_insuranceetl_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_CosmosDb_insuranceetl'"
		},
		"AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "insuranceserver80.database.windows.net"
		},
		"AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "insurancedb"
		},
		"AzureSqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "xavierroshan"
		},
		"ls_AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://insuranceadlsv2.dfs.core.windows.net/"
		},
		"ls_AzureDataLakeStorage1_properties_typeProperties_tenant": {
			"type": "string",
			"defaultValue": "42aecd79-0fe3-41dd-a79d-266977551bd8"
		},
		"ls_AzureDataLakeStorage1_properties_typeProperties_servicePrincipalId": {
			"type": "string",
			"defaultValue": "13d413ef-96cf-42bb-b200-3a91e2964025"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "insuranceDataFactoryv1_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureMySql1_connectionString": {
						"value": "[parameters('AzureMySql1_connectionString')]"
					},
					"AzureSqlDatabase1_password": {
						"value": "[parameters('AzureSqlDatabase1_password')]"
					},
					"ls_AzureBlobStorage_insuranceetl_connectionString": {
						"value": "[parameters('ls_AzureBlobStorage_insuranceetl_connectionString')]"
					},
					"ls_AzureDataLakeStorage1_servicePrincipalCredential": {
						"value": "[parameters('ls_AzureDataLakeStorage1_servicePrincipalCredential')]"
					},
					"ls_CosmosDb_insuranceetl_connectionString": {
						"value": "[parameters('ls_CosmosDb_insuranceetl_connectionString')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_userName')]"
					},
					"ls_AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('ls_AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"ls_AzureDataLakeStorage1_properties_typeProperties_tenant": {
						"value": "[parameters('ls_AzureDataLakeStorage1_properties_typeProperties_tenant')]"
					},
					"ls_AzureDataLakeStorage1_properties_typeProperties_servicePrincipalId": {
						"value": "[parameters('ls_AzureDataLakeStorage1_properties_typeProperties_servicePrincipalId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}